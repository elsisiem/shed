{
  "name": "shed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agents molt. Shed drops the tools, rules and memories a task never uses, keeps the guardrails, and checks the job still passes.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "agentmail": "^0.5.35",
    "exa-js": "^2.0.0",
    "hono": "^4.9.8",
    "mongodb": "^6.20.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
