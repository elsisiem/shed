# Copy to .env and fill in. Source of truth: src/env.ts.
# Every variable is optional. Without MONGODB_URI the app stores data in memory.
# Variables with a built-in default are commented out. Uncomment one to override it.

# MongoDB connection string. Generations, runs and lineage go to the "shed" database. Unset or unreachable means in-memory storage.
MONGODB_URI=

# Exa API key. Seeds extra tools and rules from live web sources on the first molt.
EXA_API_KEY=

# AgentMail API key. Used to email a receipt after each molt.
AGENTMAIL_API_KEY=
# AgentMail inbox the receipt is sent from. Receipts are skipped when this or the key is empty.
AGENTMAIL_INBOX=
# Address that receives the receipt. Defaults to AGENTMAIL_INBOX.
MOLT_NOTIFY_TO=

# Raindrop write key. Sends run events and token-savings signals.
RAINDROP_WRITE_KEY=
# Raindrop project id sent with each request.
# RAINDROP_PROJECT=shed

# ElevenLabs API key. Enables spoken receipts from POST /v1/speak.
ELEVENLABS_API_KEY=
# ElevenLabs voice id. Defaults to a built-in voice.
ELEVENLABS_VOICE_ID=

# Port the server listens on.
# PORT=8080
